---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPublishedArticles } from '../lib/knowledge';
import { categories } from '../data/categories';
const articles = await getPublishedArticles();
const featured = articles.filter((article) => article.data.featured).slice(0, 6);
const popularTags = [...new Set(articles.flatMap((article) => article.data.tags))].sort().slice(0, 10);
const categoryCounts = new Map(categories.map((category) => [category.id, articles.filter((article) => article.data.category === category.id).length]));
---
<SiteLayout title="Home" description="A practical, contributor-maintained wiki for independent builders. Find grounded guidance on validating, building, launching, and growing small products.">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-kicker">An open knowledge base for small teams</div>
    <h1 id="home-title">Make the next<br /><em>good decision.</em></h1>
    <p class="hero-copy">A practical wiki for people building independent products. Clear steps, real trade-offs, and sources you can check.</p>
    <form class="hero-search" action="/search/" method="get" role="search" aria-label="Search IndieWiki">
      <div class="search-box"><span aria-hidden="true" class="search-glyph">⌕</span><input name="q" type="search" placeholder="What are you trying to do?" aria-label="Search the wiki"/><span class="search-shortcut" aria-hidden="true">/</span><button class="search-submit" type="submit">Search <span aria-hidden="true">↗</span></button></div>
    </form>
    <p class="hero-footnote">Try “first users”, “AI security”, or “launch checklist” <span aria-hidden="true">·</span> Press <kbd>/</kbd> to search</p>
  </section>

  <section aria-labelledby="start-here-title">
    <div class="section-heading"><div><div class="eyebrow">A useful place to begin</div><h2 id="start-here-title">Start with the problem in front of you</h2></div><a class="text-link" href="/categories/start/">Start exploring ↗</a></div>
    <div class="start-paths">
      <a class="start-path" href="/categories/start/"><span class="path-number">01 / FIND A DIRECTION</span><h3>I have an idea</h3><p>Turn a hunch into a clear problem and a testable next step.</p></a>
      <a class="start-path" href="/categories/validate/"><span class="path-number">02 / LEARN FROM PEOPLE</span><h3>I need my first users</h3><p>Find relevant people, run focused conversations, and learn before you scale.</p></a>
      <a class="start-path" href="/categories/ship/"><span class="path-number">03 / GET IT OUT</span><h3>I’m preparing to launch</h3><p>Check the product, the path to users, and the parts that can fail.</p></a>
    </div>
  </section>

  <section aria-labelledby="topics-title">
    <div class="section-heading"><div><div class="eyebrow">The knowledge map</div><h2 id="topics-title">Browse by topic</h2><p>Twenty connected areas, one searchable library.</p></div><a class="text-link" href="/categories/">All topics ↗</a></div>
    <div class="category-grid">{categories.map((category) => <a class="category-card" href={`/categories/${category.id}/`}><span class="category-icon" aria-hidden="true">{category.icon}</span><h3>{category.label}<span class="category-count">{categoryCounts.get(category.id) || 0}</span></h3><p>{category.description}</p></a>)}</div>
  </section>

  <section aria-labelledby="featured-title">
    <div class="section-heading"><div><div class="eyebrow">Selected field notes</div><h2 id="featured-title">Useful reads for this week</h2><p>Short, evidence-aware guides for the decisions that shape a small product.</p></div><a class="text-link" href="/categories/">Browse the wiki ↗</a></div>
    {featured.length > 0 ? <div class="featured-grid">{featured.map((article) => <ArticleCard article={article} />)}</div> : <div class="empty-state"><h2>The first guides are on their way.</h2><p>Browse the knowledge map while the article library grows.</p></div>}
  </section>

  <section aria-labelledby="tag-title">
    <div class="section-heading"><div><div class="eyebrow">Find a thread</div><h2 id="tag-title">Explore by tag</h2></div></div>
    <div class="tag-index">{popularTags.map((tag) => <a href={`/tags/${encodeURIComponent(tag.toLowerCase().replaceAll(' ', '-'))}/`}>{tag} <span aria-hidden="true">↗</span></a>)}</div>
  </section>
  <aside class="home-note"><span class="note-mark" aria-hidden="true">i</span><p><strong>Built to be checked and improved.</strong> Advice is labeled by evidence and context. If you spot an error or a missing perspective, <a href="https://github.com/arunkumarkundra/indiewiki/issues">open an issue</a> or suggest an edit.</p></aside>
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found" description="This IndieWiki page could not be found." noIndex>
  <section class="empty-state" style="margin:64px auto;max-width:620px;text-align:center;padding:42px 24px"><div class="page-kicker" style="justify-content:center">404 / PAGE NOT FOUND</div><h1 style="font:800 37px var(--display);letter-spacing:-1.3px;margin:16px 0 8px">This page took a different path.</h1><p style="font-size:13px;line-height:1.7;color:#68746a">It may have moved, or the address may have a typo. Search the wiki or return to the topic map.</p><form action="/search/" method="get" role="search" class="search-box" style="max-width:470px;margin:20px auto"><input name="q" type="search" placeholder="Search IndieWiki" aria-label="Search the wiki"/><button type="submit" class="search-submit">Search</button></form><a class="text-link" href="/categories/">Browse all topics ↗</a></section>
</SiteLayout>

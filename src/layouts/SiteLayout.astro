---
import Sidebar from '../components/Sidebar.astro';
import { categories } from '../data/categories';
const { title, description, currentCategory = '', canonicalPath, noIndex = false, article = false } = Astro.props as { title: string; description: string; currentCategory?: string; canonicalPath?: string; noIndex?: boolean; article?: boolean };
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const pageTitle = title === 'Home' ? 'IndieWiki — The practical wiki for independent builders' : `${title} — IndieWiki`;
const image = new URL('/social-card.svg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f2" />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex,follow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="IndieWiki updates" href="/feed.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="IndieWiki" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/" aria-label="IndieWiki home"><span class="brand-mark" aria-hidden="true">i<span>w</span></span><span class="brand-name">IndieWiki<span class="brand-dot">.</span></span></a>
        <span class="brand-divider" aria-hidden="true"></span>
        <span class="brand-tagline">The practical wiki for independent builders.</span>
        <div class="top-actions">
          <a class="top-link" href="/about/">About</a>
          <a class="top-link contribute-top" href="https://github.com/arunkumarkundra/indiewiki/blob/main/CONTRIBUTING.md">Contribute <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="mobile-topics"><details><summary><span aria-hidden="true">☷</span> Browse topics</summary><nav>{categories.map((category) => <a href={`/categories/${category.id}/`}>{category.label}</a>)}</nav></details><a href="/search/" class="mobile-search">Search <kbd>/</kbd></a></div>
    </header>
    <div class="page-grid">
      <Sidebar current={currentCategory} />
      <main id="main" class="main-content"><slot /></main>
    </div>
    <footer class="site-footer"><div class="footer-inner"><a class="footer-brand" href="/">IndieWiki<span class="brand-dot">.</span></a><span>Independent knowledge, maintained in the open.</span><div><a href="/about/">About</a><a href="/feed.xml">RSS</a><a href="https://github.com/arunkumarkundra/indiewiki">GitHub ↗</a></div><small>© 2026 IndieWiki contributors · Read the <a href="https://github.com/arunkumarkundra/indiewiki/blob/main/GOVERNANCE.md">governance</a></small></div></footer>
    <script is:inline>
      const searchShortcut = (event) => {
        if (event.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
          event.preventDefault(); window.location.href = '/search/';
        }
      };
      document.addEventListener('keydown', searchShortcut);
    </script>
  </body>
</html>
<style is:global>

-left:3px;margin:6px 0}.prose li::marker{color:#638365}.prose a{color:#315f3e;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}.prose blockquote{margin:21px 0;padding:13px 17px;border-left:3px solid #94ae7a;background:#f1f4eb;color:#566252}.prose blockquote p:last-child{margin:0}.prose code{font:12px var(--mono);background:#eef0ea;padding:2px 4px;border-radius:3px}.prose pre{overflow:auto;padding:16px;border-radius:8px;background:#1c2923;color:#e7eee5;font-size:12px;line-height:1.65}.prose table{border-collapse:collapse;width:100%;font-size:12px}.prose th,.prose td{text-align:left;vertical-align:top;border:1px solid var(--line);padding:9px}.prose th{background:#eff2e9}.prose hr{border:0;border-top:1px solid var(--line);margin:27px 0}.related-nav{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:28px 0}.related-nav a{border:1px solid var(--line);border-radius:8px;padding:13px;background:#fff}.related-nav .nav-label{display:block;font:9px var(--mono);text-transform:uppercase;color:#7d897f;margin-bottom:6px}.related-nav strong{font:600 12px var(--display);line-height:1.45}.related-title{font:700 17px var(--display);margin:33px 0 13px}.article-tag-strip{display:flex;gap:7px;flex-wrap:wrap;margin:0 0 19px}.article-tag-strip .tag{padding:5px 8px}.category-hero{padding:7px 0 18px;border-bottom:1px solid var(--line)}.category-hero h1{font:800 34px var(--display);letter-spacing:-1.2px;margin:12px 0 8px}.category-hero p{font-size:13px;line-height:1.7;color:var(--muted);max-width:700px;margin:0}.search-results{display:grid;gap:11px;margin-top:20px}.search-result{background:#fff;border:1px solid var(--line);border-radius:8px;padding:16px}.search-result h2{font:700 15px var(--display);margin:6px 0}.search-result p{font-size:12px;line-height:1.55;color:#68746a;margin:0 0 8px}.search-result mark{background:#e8f0d6;color:inherit}.search-state{font-size:12px;color:#6c776d;margin-top:17px;min-height:20px}.search-empty{padding:25px;background:
scrollbar-width:thin}.sidebar-heading{font:500 10px var(--mono);text-transform:uppercase;letter-spacing:1.15px;color:#778078;margin:0 0 13px 9px}.side-link{display:flex;align-items:center;gap:11px;padding:8px 10px;border-radius:7px;font-size:12.5px;color:#56625b;margin:1px 0;transition:background .15s,color .15s}.side-link:hover{background:#eef1e8;color:var(--ink)}.side-link.active{background:#e9efdf;color:#315b40;font-weight:700}.side-icon{font:13px var(--mono);width:15px;text-align:center;color:#738078}.side-link.active .side-icon{color:#4f895f}.sidebar-note{border-top:1px solid var(--line);margin:26px 6px 0 8px;padding-top:17px;font-size:11px;color:var(--muted);line-height:1.55}.note-mark{width:17px;height:17px;border:1px solid #9aa698;display:inline-grid;place-items:center;border-radius:50%;font:11px var(--mono);color:#58685b}.sidebar-note p{margin:8px 0}.sidebar-note a{color:var(--green);font-size:10.5px;font-weight:700}.main-content{min-width:0;padding:0 5.25% 72px}.site-footer{background:#18241e;color:#d6ded5}.footer-inner{max-width:1420px;padding:27px 32px 24px;margin:0 auto;display:grid;grid-template-columns:160px 1fr auto;align-items:center;gap:8px 24px;font-size:11px;color:#aab5aa}.footer-brand{font:800 16px var(--display);color:#f5f5ec}.footer-inner>div{display:flex;gap:17px;color:#dce4da}.footer-inner small{grid-column:1/-1;padding-top:14px;border-top:1px solid #344139;margin-top:10px}.footer-inner small a{text-decoration:underline;text-underline-offset:2px}.eyebrow{font:500 10px var(--mono);text-transform:uppercase;letter-spacing:1.1px;color:#637267}.page-kicker{display:flex;align-items:center;gap:8px;font:500 10px var(--mono);letter-spacing:1px;text-transform:uppercase;color:#65736a}.page-kicker .kicker-line{width:22px;height:1px;background:#9eaa99}.breadcrumbs{display:flex;align-items:center;gap:9px;padding:28px 0 18px;color:#7b857b;font-size:11px;flex-wrap:wrap}.breadcrumbs>span:last-child{color:#46554b}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin:38px 0 17px}.section-heading h2{font:700 19px var(--display);letter-spacing:-.55px;margin:0}.section-heading p{font-size:12px;color:var(--muted);margin:5px 0 0}.text-link{font-size:11px;color:var(--green);font-weight:700}.article-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.article-card{background:var(--paper);border:1px solid var(--line);border-radius:9px;padding:19px 19px 17px;position:relative;transition:transform .15s,border-color .15s,box-shadow .15s;min-height:188px;display:flex;flex-direction:column}.article-card:hover{transform:translateY(-2px);border-color:#b9c7b5;box-shadow:0 8px 22px #2436220b}.article-card .card-hit{position:absolute;inset:0;z-index:1}.article-card h3{position:relative;z-index:2;font:700 16px/1.34 var(--display);letter-spacing:-.35px;margin:11px 0 7px}.article-card h3 a:hover{text-decoration:underline;text-underline-offset:3px}.article-card p{font-size:12px;line-height:1.6;color:#657168;margin:0 0 15px}.card-meta{display:flex;align-items:center;gap:7px;font:10px var(--mono);letter-spacing:.2px;color:#78847a;text-transform:uppercase}.tag-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;position:relative;z-index:2}.tag{display:inline-flex;background:#f0f2ec;color:#59655b;border:1px solid #e8ebe3;border-radius:4px;padding:4px 7px;font:9px var(--mono);text-transform:lowercase}.tag:hover{border-color:#b4c6ad;color:#315b40}.article-card.compact{min-height:150px}.empty-state{padding:28px;background:#fff;border:1px dashed #cfd6cb;border-radius:10px;color:var(--muted)}.empty-state h2{font:700 18px var(--display);color:var(--ink);margin-top:0}.reading-width{max-width:860px}.intro-copy{font-size:14px;line-height:1.75;color:#59665c;max-width:710px}.callout{padding:17px 19px;border-radius:8px;border:1px solid #dce5cd;background:#f2f5e9;color:#3d5142;font-size:13px;line-height:1.65}.callout strong{color:#263e2c}.search-box{display:flex;align-items:center;gap:10px;border:1px solid #cfd7ca;background:#fff;border-radius:9px;padding:6px 8px 6px 14px;box-shadow:0 3px 14px #25352108}.search-box:focus-within{border-color:#739779;box-shadow:0 0 0 3px #76a17b24}.search-box input{border:0;outline:0;min-width:0;flex:1;padding:11px 0;background:transparent;font-size:13px;color:var(--ink)}.search-box input::placeholder{color:#929a90}.search-submit{border:0;border-radius:6px;background:var(--ink);color:#fff;padding:10px 14px;font-size:11px;font-weight:700;cursor:pointer}.search-submit:hover{background:#31583d}.search-shortcut{font:10px var(--mono);color:#879188;border:1px solid #e1e5dd;border-radius:4px;padding:4px 6px}.category-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.category-card{background:#fff;border:1px solid var(--line);border-radius:8px;min-height:118px;padding:14px 14px 12px;transition:border-color .16s,background .16s}.category-card:hover{border-color:#b7c8af;background:#fcfdf9}.category-card .category-icon{font:14px var(--mono);color:#5e8965}.category-card h3{font:700 13px var(--display);margin:11px 0 4px;letter-spacing:-.2px}.category-card p{font-size:10.5px;line-height:1.45;color:#728075;margin:0}.category-count{font:9px var(--mono);color:#89948a;margin-left:5px}.provenance{margin:34px 0 0;padding:20px;border:1px solid #dfe5d9;border-radius:9px;background:#f3f5ee}.provenance-head{display:flex;align-items:flex-start;gap:11px}.provenance-mark{width:24px;height:24px;border-radius:6px;background:#dee9d5;display:grid;place-items:center;color:#456947;font:13px var(--mono)}.provenance h2{font:700 13px var(--display);margin:1px 0 4px}.provenance-head p{font-size:11px;color:#758075;margin:0}.provenance-meta{display:flex;gap:28px;flex-wrap:wrap;margin:18px 0 14px;padding:0}.provenance-meta div{display:grid;gap:4px}.provenance dt{font:9px var(--mono);text-transform:uppercase;letter-spacing:.6px;color:#798579}.provenance dd{font-size:11px;color:#334338;margin:0;text-transform:capitalize}.source-list,.seed-d
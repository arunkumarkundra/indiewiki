ine-height:1.6;color:#667166}.home-note strong{color:#354639}.home-note p{margin:0}.tag-index{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.tag-index a{padding:8px 10px;border:1px solid var(--line);border-radius:6px;background:#fff;font-size:11px;color:#526157}.about-hero{padding:35px 0 19px}.about-hero h1{font:800 39px var(--display);letter-spacing:-1.6px;margin:10px 0}.about-hero p{font-size:15px;line-height:1.7;color:#68746a;max-width:730px}.about-section{border-top:1px solid var(--line);padding:21px 0}.about-section h2{font:700 18px var(--display);margin:0 0 9px}.about-section p,.about-section li{font-size:13px;line-height:1.75;color:#58655b}.about-section ul{padding-left:20px}.about-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.about-step{padding:14px;border:1px solid var(--line);border-radius:8px;background:#fff}.about-step span{font:10px var(--mono);color:#658468}.about-step strong{display:block;font:700 12px var(--display);margin:9px 0 5px}.about-step p{font-size:10.5px;line-height:1.55;color:#758076;margin:0}.mobile-menu-note{display:none}
